{
  "name": "iron-dust",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "start": "vite --host 127.0.0.1",
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --experimental-strip-types --test src/game/core/fixedStep.test.ts && npm run mission:test",
    "map:dev": "vite --config vite.map.config.ts --host 127.0.0.1 --open /map-preview.html",
    "studio": "vite --config vite.map.config.ts --host 127.0.0.1 --open \"/map-preview.html?studio=1\"",
    "map:check": "tsc -p tsconfig.map.json",
    "map:test": "node --experimental-strip-types scripts/check-test-ground.ts",
    "world:render:test": "node --experimental-strip-types scripts/check-world-rendering.ts",
    "map:build": "npm run map:check && vite build --config vite.map.config.ts",
    "tank:test": "node --experimental-strip-types scripts/check-tank-model.ts && node --experimental-strip-types scripts/check-second-tank.ts",
    "turret:test": "node --experimental-strip-types scripts/check-turret.ts && node --experimental-strip-types scripts/check-turret.ts 02",
    "effects:test": "node --experimental-strip-types scripts/check-movement-effects.ts",
    "audio:test": "node --experimental-strip-types scripts/check-audio.ts",
    "drive:test": "node --experimental-strip-types scripts/check-driving.ts && node --experimental-strip-types scripts/check-driving.ts 02",
    "damage:test": "node --experimental-strip-types scripts/check-damage.ts",
    "smoke:test": "node --experimental-strip-types scripts/check-smoke.ts",
    "combat:test": "node --experimental-strip-types scripts/check-combat.ts && node --experimental-strip-types scripts/check-combat-input.ts && node --experimental-strip-types scripts/check-pointer-lock.ts && node --experimental-strip-types scripts/check-camera.ts && node --experimental-strip-types scripts/check-ai.ts",
    "mg:test": "node --experimental-strip-types scripts/check-machine-gun.ts && node --experimental-strip-types scripts/check-machine-gun-input.ts",
    "touch:test": "node --experimental-strip-types scripts/check-touch-input.ts",
    "lan:start": "npm run map:build && node --experimental-strip-types scripts/lan-server.ts",
    "lan:check": "tsc -p tsconfig.lan.json",
    "lan:test": "node --experimental-strip-types scripts/check-network-simulation.ts && node --experimental-strip-types scripts/check-lan-server.ts",
    "build:itch": "npm run map:check && vite build --config vite.itch.config.ts",
    "shell:test": "node --experimental-strip-types scripts/check-shell.ts",
    "mission:test": "node --experimental-strip-types scripts/check-missions.ts",
    "infantry:test": "node --experimental-strip-types scripts/check-infantry.ts"
  },
  "dependencies": {
    "@babylonjs/core": "9.32.0",
    "@babylonjs/havok": "1.3.14",
    "@babylonjs/loaders": "9.32.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "ws": "8.22.0",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.1.2",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
